# Public managed Supabase project values (safe for frontend usage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend only. Enter real values in your host's secret settings; never commit them.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Explicit owner attestation of a billed Gemini project, after reviewing current data terms.
GEMINI_PAID_PROJECT=false
GEMINI_MODEL=gemini-flash-latest
GEMINI_STRONG_ENABLED=false
GEMINI_STRONG_MODEL=gemini-pro-latest
AI_ENABLED=true
# Opt in only after live speech/search acceptance tests.
SPEECH_ENABLED=false
GEMINI_STT_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
SEARCH_ENABLED=false
MUSIC_ENABLED=false
# HTTPS deployment origin, without trailing slash.
APP_URL=
# Backend-generated random secret for the scheduler. Set through host secret management.
CRON_SECRET=
# Supabase user UUID of the app owner, not an email or client-controlled flag.
OWNER_USER_ID=
